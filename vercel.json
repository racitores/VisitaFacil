{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/messages",
      "schedule": "0 7 * * *"
    }
  ],
  "installCommand": "npm ci",
  "regions": [
    "fra1"
  ]
}
